#
# Global ARGs required
#
# Versions
ARG HAWTIO_ONLINE_VERSION=3.2.0
ARG JOLOKIA_VERSION=2.6.0
ARG HAWTIO_REACT_VERSION=2.4.1

#
# The user id for nginx
#
ARG NGINX_USER=65532

##############################################################################

# Regardless of arch being required (amd64 or arm64) this will
# 'compile' the hawtio-online javascript package natively without
# resorting to a foreign image that would have to be emulated and
# so really sloooow!
# The resulting javascript/assets are then copied into the final image
# that conforms with the correct architecture.
FROM --platform=${BUILDPLATFORM} docker.io/node:26-alpine as staging

WORKDIR /hawtio-online

COPY package.json yarn.lock ./
COPY .yarnrc.yml ./
COPY packages/ packages/
COPY .yarn/plugins .yarn/plugins
COPY .yarn/releases .yarn/releases

RUN ln -s "$(pwd)/.yarn/releases/"yarn-*.cjs /usr/local/bin/yarn
RUN yarn install
RUN yarn build

##############################################################################

#
# Standard hi/nginx:1.30.7 image is distroless (no shell)
# Uses "-builder" tag:
# - nginx.sh / config.sh require shell at container startup
# - dnf required to install envsubst and update
#
# Final Image
#
FROM registry.access.redhat.com/hi/nginx:1.30.7-builder

#
# From global variables
#
ARG HAWTIO_ONLINE_VERSION
ARG JOLOKIA_VERSION
ARG HAWTIO_REACT_VERSION

#
# nginx environment
#
ARG NGINX_ETC=/etc/nginx
ARG NGINX_CONFIG=${NGINX_ETC}/nginx.conf
ARG NGINX_CACHE=/var/cache/nginx
ARG NGINX_LOG=/var/log/nginx
ARG NGINX_SHARE=/usr/share/nginx
ARG NGINX_HTML=${NGINX_SHARE}/html
ARG NGINX_ONLINE=${NGINX_HTML}/online
ARG NGINX_USER

ARG HAWTIO_DESCRIPTION="The Hawtio Console eases the discovery and management of 'hawtio-enabled' applications deployed on OpenShift."

LABEL description="${HAWTIO_DESCRIPTION}" \
    io.hawt.jolokia.version="${JOLOKIA_VERSION}" \
    io.hawt.react.version="${HAWTIO_REACT_VERSION}" \
    io.k8s.description="${HAWTIO_DESCRIPTION}" \
    io.k8s.display-name="Hawtio Console" \
    io.openshift.expose-services="8443:https" \
    io.openshift.tags="hawtio,jolokia" \
    maintainer="Paul Richardson <p.g.richardson@phantomjinx.co.uk>" \
    name="Hawtio Online" \
    summary="${HAWTIO_DESCRIPTION}" \
    version="${HAWTIO_ONLINE_VERSION}"

# Switch to root user
USER 0

#
# Perform an upgrade of all packages to ensure
# any outstanding packages are updates from the
# base images
#
RUN microdnf upgrade -y

# Install envsubst for template and awk for nginx script
RUN microdnf -y install --setopt=tsflags=nodocs gettext-envsubst gawk \
    && microdnf clean all

#
# Modify the nginx configuration
#
# Forward request and error logs to docker log collector
# - Change pid file location & remove nginx user & change port to 8080
# - modify perms for non-root runtime
#
RUN mkdir -p ${NGINX_CACHE}/pods ${NGINX_CACHE}/rbac ${NGINX_CACHE}/rbac2 && \
    ln -sf /dev/stdout ${NGINX_LOG}/access.log && \
    ln -sf /dev/stderr ${NGINX_LOG}/error.log && \
    chown -R ${NGINX_USER} ${NGINX_CACHE} ${NGINX_ETC} ${NGINX_LOG} ${NGINX_SHARE} && \
    chmod -R g=u ${NGINX_CACHE} ${NGINX_ETC} ${NGINX_LOG}

#
# Remove default installed boilerplate
#
RUN rm -f ${NGINX_ETC}/conf.d/default.conf \
          ${NGINX_HTML}/index.html

#
# Update locations of osconsole config
#
RUN mkdir -p ${NGINX_ONLINE}/osconsole && \
    touch ${NGINX_ONLINE}/osconsole/config.json && \
    chown ${NGINX_USER} ${NGINX_ONLINE}/osconsole/config.json && \
    chmod g=u ${NGINX_ONLINE}/osconsole/config.json

#
# Copy include directory
#
COPY docker/includes /etc/nginx/includes

#
# Copy docker config files over
#
COPY docker/nginx-gateway.conf.template \
    docker/osconsole/config.sh \
    docker/nginx.sh \
    /
RUN chmod 0755 /nginx.sh /config.sh

#
# Copy error pages
#
COPY docker/hawtio-?0?.html ${NGINX_HTML}/

#
# Copy built hawtio-online app from staging container
#
COPY --from=staging /hawtio-online/packages/online-shell/build ${NGINX_ONLINE}/

#
# Copy licenses
#
RUN mkdir -p /opt/hawtio/licenses
COPY --from=staging /hawtio-online/docker/licenses /opt/hawtio/licenses

#
# Finalize permissions for nginx files
#
RUN chown -R ${NGINX_USER} ${NGINX_SHARE}

EXPOSE 8443
EXPOSE 8080

# Return to nginx user
USER ${NGINX_USER}

ENTRYPOINT ["/nginx.sh"]
