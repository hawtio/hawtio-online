#
# Global ARGs required
#
# Version
ARG HAWTIO_GATEWAY_VERSION=2.5.0
# The hawtio namespace for the build images
ARG HAWTIO_NAMESPACE="rhbac-4"
# Name of the gateway without the main registry (used in labels)
ARG HAWTIO_GATEWAY_IMAGE_LABEL_NAME=${HAWTIO_NAMESPACE}/hawtio-gateway-rhel9

#
# The user id for node
#
ARG NODE_USER=65532

FROM registry.access.redhat.com/hi/nodejs:26 as staging

USER root

#
# Copy all the source to a triage directory
#
WORKDIR /hawtio-source-gateway

COPY package.json yarn.lock ./
COPY .yarnrc.yml ./
COPY packages/ packages/
COPY .yarn/plugins .yarn/plugins
COPY .yarn/releases .yarn/releases

RUN ln -s "$(pwd)/.yarn/releases/"yarn-*.cjs /usr/local/bin/yarn
RUN yarn install
RUN yarn build:gateway

# Adds the licences to the docker directory
RUN yarn license

RUN find /hawtio-source-gateway

RUN mkdir /hawtio-gateway

# Move the built package to staging directory
RUN mv packages/gateway/dist/* /hawtio-gateway

# Copy the run-scripts from source
RUN mv packages/gateway/env.product /hawtio-gateway
RUN mv packages/gateway/gateway.sh /hawtio-gateway

# Copy the licences directory
RUN mv docker/licenses /hawtio-gateway/

COPY Makefile ./
RUN cat Makefile | grep ^VERSION.*[0-9] >> hawtio-online-gateway-version


##############################################################################

#
# Final Image
#
# Standard hi/nodejs:26 image is distroless (no shell)
# Uses "-builder" tag:
# - dnf required to install envsubst and update
#
FROM registry.access.redhat.com/hi/nodejs:26-builder

#
# From global variables
#
ARG HAWTIO_GATEWAY_VERSION
ARG HAWTIO_GATEWAY_IMAGE_LABEL_NAME

#
# The user id for node
#
ARG NODE_USER

#
# Hawtio Gateway environment
#
# Location of hawtio-gateway in staging container (same as WORKDIR)
#
ARG HAWTIO_GATEWAY_STAGING_BUILD_DIR=/hawtio-gateway

#
# Final destination directory of app
#
ARG GATEWAY_DEST_DIR=/opt/hawtio-online-gateway

#
# Description used in labels
#
ARG HAWTIO_DESCRIPTION="The Red Hat build of HawtIO Gateway providing extra function support for HawtIO on OpenShift."

#
# Label metadata
#
LABEL com.redhat.component="hawtio-gateway-container" \
    description="${HAWTIO_DESCRIPTION}" \
    io.k8s.description="${HAWTIO_DESCRIPTION}" \
    io.k8s.display-name="Red Hat build of HawtIO Gateway" \
    io.openshift.tags="hawtio,gateway,jolokia" \
    maintainer="Paul Richardson <Paul.Richardson3@ibm.com>" \
    name="${HAWTIO_GATEWAY_IMAGE_LABEL_NAME}" \
    summary="${HAWTIO_DESCRIPTION}" \
    version="${HAWTIO_GATEWAY_VERSION}" \
    version.file="/opt/hawtio-gateway/hawtio-online-gateway-version"

# Switch to root user
USER 0

#
# Perform an upgrade of all packages to ensure
# any outstanding packages are updates from the
# base images
#
RUN microdnf upgrade -y

#
# Copy built hawtio-online-gateway app from staging container
# - Note: dist is the build directory after compilation in the staging
#
COPY --from=staging ${HAWTIO_GATEWAY_STAGING_BUILD_DIR} ${GATEWAY_DEST_DIR}/

#
# Add link for licenses
#
RUN mkdir -p /opt/hawtio-gateway && ln -s ${GATEWAY_DEST_DIR}/licenses /opt/hawtio-gateway/licenses

#
# Finalize permissions for gateway files
#
RUN chown -R ${NODE_USER}:0 ${GATEWAY_DEST_DIR} && \
    chmod -R g=u ${GATEWAY_DEST_DIR} && \
    chmod +x ${GATEWAY_DEST_DIR}/gateway.sh

#
# Allow the environment to be updated by arbitrary image user
#
RUN chmod 666 ${GATEWAY_DEST_DIR}/env.product

USER ${NODE_USER}

EXPOSE 3000

ENTRYPOINT ["/opt/hawtio-online-gateway/gateway.sh"]
