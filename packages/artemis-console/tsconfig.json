{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2015",
    "lib": [ "dom", "esnext" ],
    "jsx": "react-jsx",

    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",

    /* JavaScript Support */
    "allowJs": true,

    /* Emit */
    "declaration": true,
    "declarationDir": "dist/dts",
    "emitDeclarationOnly": true,
//    "noEmit": true,

    /* Interop Constraints */
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Type Checking */
    "strict": true,

    /* Completeness */
    "skipLibCheck": true
  },
  "include": [ "src" ]
}
